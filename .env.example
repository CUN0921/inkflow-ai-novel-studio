# 服务端口（可选，默认 4310）
PORT=4310

# 默认模型配置。未单独配置某个任务时会使用这一组设置。
OPENAI_API_KEY=请填写你的密钥
OPENAI_MODEL=请填写模型名称
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_PROTOCOL=responses

# 可选：为不同任务配置独立模型。对应密钥留空时复用 OPENAI_API_KEY。
AI_PLANNER_MODEL=
AI_PLANNER_BASE_URL=
AI_PLANNER_PROTOCOL=responses
AI_PLANNER_API_KEY=

AI_WRITER_MODEL=
AI_WRITER_BASE_URL=
AI_WRITER_PROTOCOL=responses
AI_WRITER_API_KEY=

AI_REVIEWER_MODEL=
AI_REVIEWER_BASE_URL=
AI_REVIEWER_PROTOCOL=responses
AI_REVIEWER_API_KEY=

AI_CHECKER_MODEL=
AI_CHECKER_BASE_URL=
AI_CHECKER_PROTOCOL=responses
AI_CHECKER_API_KEY=
